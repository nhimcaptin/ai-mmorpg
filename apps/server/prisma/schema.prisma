generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Bảng probe hạ tầng; chưa phải model Account/Character hoặc economy.
model FoundationProbe {
  id        String   @id @db.Uuid
  value     Int      @default(0)
  createdAt DateTime @default(now())
}

// Technical atomic operation ledger, not a gameplay reward policy.
model OperationReceipt {
  scope       String
  key         String
  payloadHash String
  result      Json
  @@id([scope, key])
}

enum CharacterClass {
  PHYSICAL_DPS
  MAGIC_DPS
  TANK
}
model Account {
  id String @id @db.Uuid
  character Character?
}
model Character {
  id String @id @db.Uuid
  accountId String @unique @db.Uuid
  account Account @relation(fields: [accountId], references: [id])
  class CharacterClass
  realm Int
  star Int
  hp BigInt
  ki BigInt
  gold BigInt
  mapId String
  areaId String
  respawnId String
  pkEnabled Boolean
}

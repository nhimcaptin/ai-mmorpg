  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022"], "strict": true,
    "module": "NodeNext", "moduleResolution": "NodeNext", "esModuleInterop": true,
    "skipLibCheck": true, "declaration": true, "sourceMap": true,
    "noUncheckedIndexedAccess": true, "forceConsistentCasingInFileNames": true
  }
